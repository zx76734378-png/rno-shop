# RNO-SHOP Server Configuration
# Copy this file to .env and fill in your values

# Database
# SQLite (for local development):
DATABASE_URL="file:./dev.db"
# PostgreSQL (for production):
# DATABASE_URL="postgresql://user:password@host:5432/rno_shop?schema=public"

# JWT Secrets (generate strong random keys for production):
# Run in terminal: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-jwt-secret-here"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-here"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3000

# Frontend URLs (used for CORS)
FRONTEND_URL="http://localhost:5173"
ADMIN_URL="http://localhost:5174"

# Environment: "development" or "production"
NODE_ENV="development"
